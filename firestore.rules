rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function isOwnerAdminEmail() {
      return isAuth()
        && request.auth.token.email in [
          'harshdeepgohil@gmail.com',
          'harshdpsinh@gmail.com'
        ];
    }
    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // Being signed in is NOT enough. The Firebase API key ships in the client bundle,
    // so anyone can mint an auth account against this project; only users an admin has
    // provisioned in /users with a valid role may touch business data.
    function isStaff() {
      return isOwnerAdminEmail()
        || (hasProfile() && userProfile().role in ['admin', 'staff']);
    }
    // Reader is the overnight-tester / observer role. It is granted by an admin in
    // /users/{uid}.role == 'reader'. These rules — not the UI — are what stop writes.
    // A reader token that calls set()/update()/delete() on any business document is
    // rejected here even if a button is still visible or an agent ignores instructions.
    function isReader() {
      return hasProfile() && userProfile().role == 'reader';
    }
    function canReadBusiness() {
      return isStaff() || isReader();
    }
    function isAdmin() {
      return isOwnerAdminEmail()
        || (hasProfile() && userProfile().role == 'admin');
    }
    function isSelf(userId) { return isAuth() && request.auth.uid == userId; }
    function validRole(role) { return role in ['admin', 'staff', 'reader']; }
    function validUserProfile() {
      return request.resource.data.role is string
        && validRole(request.resource.data.role)
        && request.resource.data.email is string
        && request.resource.data.name is string;
    }
    function isSoftDeleteChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['deleted', 'deletedAt']);
    }

    match /clients/{clientId} {
      allow read: if canReadBusiness();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
      match /documents/{docId} {
        allow read: if canReadBusiness();
        allow create, update: if isStaff();
        allow delete: if isAdmin();
      }
    }
    match /families/{familyId} {
      allow read: if canReadBusiness();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /policies/{policyId} {
      allow read: if canReadBusiness();
      allow create: if isStaff();
      allow update: if isStaff() && (!isSoftDeleteChange() || isAdmin());
      allow delete: if isAdmin();
    }
    match /proposals/{proposalId} {
      allow read: if canReadBusiness();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /claims/{claimId} {
      allow read: if canReadBusiness();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /leads/{leadId} {
      allow read: if canReadBusiness();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /lead_followups/{followupId} {
      allow read: if canReadBusiness();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /endorsements/{endorsementId} {
      allow read: if canReadBusiness();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /documents/{documentId} {
      allow read: if canReadBusiness();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /message_logs/{messageId} {
      allow read: if canReadBusiness();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /renewal_reminder_settings/{docId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /renewal_reminder_logs/{docId} {
      allow read: if canReadBusiness();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    // Written only by the server (webhook and sender) using the admin SDK,
    // which bypasses these rules. Staff read, and may mark a message read —
    // nothing else from the browser. Readers may read only.
    match /whatsapp_messages/{messageId} {
      allow read: if canReadBusiness();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }
    match /commission_master/{commissionMasterId} {
      allow read: if canReadBusiness();
      allow create, update, delete: if isAdmin();
    }
    match /commission_transactions/{commissionTransactionId} {
      allow read: if canReadBusiness();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /audit_logs/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    match /sub_brokers/{subBrokerId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /sales_managers/{salesManagerId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /reports_saved_filters/{filterId} {
      allow read: if canReadBusiness();
      allow create, update, delete: if isStaff();
    }
    match /client_activities/{activityId} {
      allow read: if canReadBusiness();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /occasion_logs/{logId} {
      allow read: if canReadBusiness();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      // Self-provisioning is deliberately NOT allowed. Previously any signed-in user
      // could create their own 'staff' profile and unlock the entire CRM. Staff
      // and reader accounts must be created by an admin through the Admin Users page.
      allow create: if isAdmin() && validUserProfile();
      allow update: if isAdmin()
        && validUserProfile()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email', 'role', 'updatedAt']);
      allow delete: if false;
    }
    match /{document=**}          { allow read, write: if false; }
  }
}
