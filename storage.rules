// storage.rules
// Signed-in is not enough: the Firebase API key is public, so anyone can mint
// an auth account. Only provisioned staff (or the owner emails) may write.
// Readers may download existing files and cannot upload or delete.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwnerAdminEmail() {
      return request.auth != null
        && request.auth.token.email in [
          'harshdeepgohil@gmail.com',
          'harshdpsinh@gmail.com'
        ];
    }
    function staffProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return request.auth != null
          && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function isStaff() {
      return isOwnerAdminEmail()
        || (hasProfile() && staffProfile().role in ['admin', 'staff']);
    }
    function isReader() {
      return hasProfile() && staffProfile().role == 'reader';
    }
    function canRead() {
      return isStaff() || isReader();
    }

    match /clients/{clientId}/{allPaths=**} {
      allow read: if canRead();
      allow delete: if isStaff();
      allow write: if isStaff()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|image/.*');
    }

    match /policies/{policyId}/{allPaths=**} {
      allow read: if canRead();
      allow delete: if isStaff();
      allow write: if isStaff()
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }

    match /documents/{ownerType}/{ownerId}/{allPaths=**} {
      allow read: if canRead();
      allow delete: if isStaff();
      allow write: if isStaff()
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|image/.*|text/csv|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
    }

    match /commission/{batchId}/{allPaths=**} {
      allow read: if canRead();
      allow delete: if isStaff();
      allow write: if isStaff()
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|image/.*|text/csv|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
