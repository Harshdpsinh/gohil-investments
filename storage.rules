// storage.rules
// ─────────────────────────────────────────────────────────────
// PASTE THIS into Firebase Console → Storage → Rules tab.
// Allows signed-in users to read/write CRM files with strict size/type limits.
// Client files: 10 MB. Policy PDFs and shared documents: 25 MB.
// ─────────────────────────────────────────────────────────────
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /clients/{clientId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow delete: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|image/.*');
    }

    match /policies/{policyId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow delete: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }

    match /documents/{ownerType}/{ownerId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow delete: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|image/.*|text/csv|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
    }

    match /commission/{batchId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow delete: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|image/.*|text/csv|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
    }

    // Block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
