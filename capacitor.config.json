{
  "appId": "com.gohilinvestments.crm",
  "appName": "Gohil Investments CRM",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://gohil-investments.vercel.app",
    "cleartext": false,
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 4000,
      "backgroundColor": "#f8fafc",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true,
      "scrollAssist": true
    }
  }
}
